else
  export NODE_PATH="/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/kss@3.1.0_chokidar@3.6.0/node_modules/kss/bin/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/kss@3.1.0_chokidar@3.6.0/node_modules/kss/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/kss@3.1.0_chokidar@3.6.0/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../kss/bin/kss-node" "$@"
else
  exec node  "$basedir/../kss/bin/kss-node" "$@"
fi
