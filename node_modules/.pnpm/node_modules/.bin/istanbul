#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/istanbul@0.4.5/node_modules/istanbul/lib/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/istanbul@0.4.5/node_modules/istanbul/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/istanbul@0.4.5/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/istanbul@0.4.5/node_modules/istanbul/lib/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/istanbul@0.4.5/node_modules/istanbul/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/istanbul@0.4.5/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../istanbul/lib/cli.js" "$@"
else
  exec node  "$basedir/../istanbul/lib/cli.js" "$@"
fi
