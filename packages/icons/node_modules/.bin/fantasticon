#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/@twbs+fantasticon@2.9.0/node_modules/@twbs/fantasticon/bin/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/@twbs+fantasticon@2.9.0/node_modules/@twbs/fantasticon/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/@twbs+fantasticon@2.9.0/node_modules/@twbs/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/@twbs+fantasticon@2.9.0/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/@twbs+fantasticon@2.9.0/node_modules/@twbs/fantasticon/bin/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/@twbs+fantasticon@2.9.0/node_modules/@twbs/fantasticon/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/@twbs+fantasticon@2.9.0/node_modules/@twbs/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/@twbs+fantasticon@2.9.0/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@twbs/fantasticon/bin/fantasticon" "$@"
else
  exec node  "$basedir/../@twbs/fantasticon/bin/fantasticon" "$@"
fi
