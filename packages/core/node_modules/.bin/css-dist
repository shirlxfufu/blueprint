#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/xinyif/Documents/GitHub/blueprint/packages/node-build-scripts/node_modules:/Users/xinyif/Documents/GitHub/blueprint/packages/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules:/Users/xinyif/Documents/GitHub/node_modules:/Users/xinyif/Documents/node_modules:/Users/xinyif/node_modules:/Users/node_modules:/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/xinyif/Documents/GitHub/blueprint/packages/node-build-scripts/node_modules:/Users/xinyif/Documents/GitHub/blueprint/packages/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules:/Users/xinyif/Documents/GitHub/node_modules:/Users/xinyif/Documents/node_modules:/Users/xinyif/node_modules:/Users/node_modules:/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@blueprintjs/node-build-scripts/css-dist.mjs" "$@"
else
  exec node  "$basedir/../@blueprintjs/node-build-scripts/css-dist.mjs" "$@"
fi
