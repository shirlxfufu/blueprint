#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/xinyif/Documents/GitHub/blueprint/packages/core/scripts/node_modules:/Users/xinyif/Documents/GitHub/blueprint/packages/core/node_modules:/Users/xinyif/Documents/GitHub/blueprint/packages/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules:/Users/xinyif/Documents/GitHub/node_modules:/Users/xinyif/Documents/node_modules:/Users/xinyif/node_modules:/Users/node_modules:/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/xinyif/Documents/GitHub/blueprint/packages/core/scripts/node_modules:/Users/xinyif/Documents/GitHub/blueprint/packages/core/node_modules:/Users/xinyif/Documents/GitHub/blueprint/packages/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules:/Users/xinyif/Documents/GitHub/node_modules:/Users/xinyif/Documents/node_modules:/Users/xinyif/node_modules:/Users/node_modules:/node_modules:/Users/xinyif/Documents/GitHub/blueprint/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir//bin/bash" ]; then
  exec "$basedir//bin/bash"  "$basedir/../@blueprintjs/core/scripts/upgrade-blueprint-2.0.0-rename.sh" "$@"
else
  exec /bin/bash  "$basedir/../@blueprintjs/core/scripts/upgrade-blueprint-2.0.0-rename.sh" "$@"
fi
